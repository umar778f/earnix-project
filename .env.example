# ==============================================================================
# EARNIX — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and replace the placeholders with your credentials.
# NEVER commit .env.local or expose production secrets in source control.

# Application URL (Production: https://earnix-project.vercel.app | Local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://earnix-project.vercel.app

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Available from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-side only: Used for admin/background operations. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# AI Configuration (Gemini API)
# ------------------------------------------------------------------------------
# Server-side only: Used for document OCR extraction and grounded copilot queries.
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# Optional Multi-Currency Exchange Rate Provider
# ------------------------------------------------------------------------------
# Leave empty to use default public endpoints (e.g. Frankfurter / ECB)
EXCHANGE_RATE_API_KEY=

